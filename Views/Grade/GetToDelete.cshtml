@model GradeDTO

<div class="container text-center">
	<h1 class="my-5">Delete grade @Model.Topic by student @Model.StudentName</h1>
	<h4 class="my-5 text-danger">Do you really want to delete this grade?</h4>
	<table class="table table-primary table-striped rounded shadow">
			<thead>
				<tr>
							<th scope="col">Student</th>
							<th scope="col">Subject</th>
							<th scope="col">Topic</th>
							<th scope="col">Mark</th>
							<th scope="col">Date</th>
							<th scope="col">Action</th>
				</tr>
			</thead>
			<tbody>
						<tr>
							<th scope="row">@Model.StudentName</th>
							<td>@Model.SubjectName</td>
							<td>@Model.Topic</td>
							<td>@Model.Mark</td>
							<td>@Model.Date</td>
						  <td>
							  <div class="d-flex align-items-center justify-content-center gap-2">
								<form method="post">
								  <button type="submit" class="btn btn-danger" asp-action="delete" 
								  asp-route-id="@Model.Id">delete</button>
								</form>
								<a asp-action="Index" class="btn btn-secondary text-white">Back</a>
							  </div>
						  </td>
						</tr>
			</tbody>
		</table>
</div>

