@using ASP.NetCoreMVC_SchoolSystem
@using ASP.NetCoreMVC_SchoolSystem.Models
@using ASP.NetCoreMVC_SchoolSystem.DTO
@using ASP.NetCoreMVC_SchoolSystem.ViewModels
@model ASP.NetCoreMVC_SchoolSystem.Models.AppUsers

<div class="container text-center">
	<h1 class="my-5">Delete user @Model.UserName</h1>
	<h4 class="my-5 text-danger">Do you really want to delete this user?</h4>
	<table class="table table-primary table-striped rounded shadow">
			<thead>
				<tr>
					<th scope="col">User ID</th>
					<th scope="col">User name</th>
					<th scope="col">Email</th>
					<th scope="col">Action</th>
				</tr>
			</thead>
			<tbody>
						<tr>
						  <td>@Model.Id</td>
						  <td>@Model.UserName</td>
						  <td>@Model.Email</td>
						  <td>
							  <div class="d-flex align-items-center justify-content-center gap-2">
								<form method="post">
								  <button type="submit" class="btn btn-danger" asp-action="delete" 
								  asp-route-id="@Model.Id">delete</button>
								</form>
								<a asp-action="Index" class="btn btn-secondary text-white">Back</a>
							  </div>
						  </td>
						</tr>
			</tbody>
		</table>
</div>
